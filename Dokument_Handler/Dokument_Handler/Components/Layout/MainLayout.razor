@inherits LayoutComponentBase
@using Dokument_Handler.Services
@using Dokument_Handler.Shared
@inject NavigationManager Nav
@inject AuthService Auth

<div class="app-layout">
    <nav class="sidebar">
        <div class="sidebar-header">
            <a class="sidebar-logo" href="/">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14,2 14,8 20,8"/>
                </svg>
                DokuHandler
            </a>
        </div>
        <div class="sidebar-nav">
            <div class="sidebar-section-label">Navigation</div>
            <NavLink class="sidebar-link" href="/" Match="NavLinkMatch.All">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                    <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
                </svg>
                Übersicht
            </NavLink>
            <NavLink class="sidebar-link" href="/upload">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                    <polyline points="17,8 12,3 7,8"/><line x1="12" y1="3" x2="12" y2="15"/>
                </svg>
                Hochladen
            </NavLink>
            <NavLink class="sidebar-link" href="/search">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                Suche
            </NavLink>

            <div class="sidebar-section-label" style="margin-top:.75rem">Kategorien</div>
            <NavLink class="sidebar-link" href="/kategorie/Alle">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/>
                    <line x1="8" y1="18" x2="21" y2="18"/>
                    <line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/>
                    <line x1="3" y1="18" x2="3.01" y2="18"/>
                </svg>
                Alle Dokumente
            </NavLink>
            <NavLink class="sidebar-link" href="/kategorie/Rechnungen">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                </svg>
                Rechnungen
            </NavLink>
            <NavLink class="sidebar-link" href="/kategorie/Verträge">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14,2 14,8 20,8"/>
                    <line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
                    <polyline points="10,9 9,9 8,9"/>
                </svg>
                Verträge
            </NavLink>
            <NavLink class="sidebar-link" href="/kategorie/Steuern">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 7H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                </svg>
                Steuern
            </NavLink>
            <NavLink class="sidebar-link" href="/kategorien" style="opacity:.7;font-size:.82rem;padding-top:.3rem">
                + Alle anzeigen
            </NavLink>

            <div class="sidebar-section-label" style="margin-top:.75rem">Einstellungen</div>
            <NavLink class="sidebar-link" href="/einstellungen">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="3"/>
                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/>
                </svg>
                App-Einstellungen
            </NavLink>
        </div>

        <div class="sidebar-footer">
            <ThemeToggleButton />
        </div>
    </nav>

    <div class="main-content">
        @Body
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        if (!Auth.IsAuthenticated && !Nav.Uri.Contains("/login"))
        {
            Nav.NavigateTo("/login", replace: true);
        }
    }
}
